{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "metadata-agent-canvas": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/assets",
              {
                "glob": "material-icons.woff2",
                "input": "node_modules/material-icons/iconfont",
                "output": "fonts"
              },
              {
                "glob": "roboto-latin{,-ext}-{300,400,500}-normal.woff2",
                "input": "node_modules/@fontsource/roboto/files",
                "output": "fonts"
              }
            ],
            "styles": [
              "src/styles/main.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.4mb",
                  "maximumError": "1.6mb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all",
              "optimization": true,
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "namedChunks": true
            },
            "extension": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.4mb",
                  "maximumError": "1.6mb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "outputPath": "dist-extension",
              "outputHashing": "none",
              "optimization": true,
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "allowedHosts": [
              "localhost"
            ]
          },
          "configurations": {
            "production": {
              "buildTarget": "metadata-agent-canvas:build:production"
            },
            "development": {
              "buildTarget": "metadata-agent-canvas:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "karmaConfig": "karma.conf.js",
            "tsConfig": "tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "styles": [
              "src/styles/main.scss"
            ],
            "assets": [
              "src/assets",
              {
                "glob": "material-icons.woff2",
                "input": "node_modules/material-icons/iconfont",
                "output": "fonts"
              },
              {
                "glob": "_codepoints.scss",
                "input": "node_modules/material-icons/css",
                "output": "fonts"
              },
              {
                "glob": "roboto-latin{,-ext}-{300,400,500}-normal.woff2",
                "input": "node_modules/@fontsource/roboto/files",
                "output": "fonts"
              },
              {
                "glob": "**/*.{ts,html}",
                "input": "src/app",
                "output": "repo/src/app",
                "ignore": [
                  "**/*.spec.ts",
                  "testing/**"
                ]
              },
              {
                "glob": "README*.md",
                "input": ".",
                "output": "repo"
              }
            ],
            "browsers": "ChromeHeadless"
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
